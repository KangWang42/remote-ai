diff --git a/xiaohongshu/creator_session.go b/xiaohongshu/creator_session.go
index 7399d43..3700119 100644
--- a/xiaohongshu/creator_session.go
+++ b/xiaohongshu/creator_session.go
@@ -1,6 +1,8 @@
 package xiaohongshu
 
 import (
+	"net/url"
+	"strings"
 	"time"
 
 	"github.com/go-rod/rod"
@@ -12,6 +14,9 @@ const (
 	urlOfCreatorHome = `https://creator.xiaohongshu.com/?source=official`
 
 	creatorSessionCookie  = "galaxy_creator_session_id"
+	creatorUserIDCookie   = "x-user-id-creator.xiaohongshu.com"
+	webSessionCookie      = "web_session"
+	creatorHost           = "creator.xiaohongshu.com"
 	creatorSessionTimeout = 15 * time.Second
 )
 
@@ -28,7 +33,7 @@ func ensureCreatorSession(page *rod.Page) error {
 	deadline := time.Now().Add(creatorSessionTimeout)
 	for time.Now().Before(deadline) {
 		time.Sleep(500 * time.Millisecond)
-		if hasCreatorSession(page) {
+		if hasCreatorSession(page) || onCreatorPageWithWebSession(page) {
 			humanize.Delay(page.GetContext(), humanize.AfterNavigate)
 			return nil
 		}
@@ -42,7 +47,30 @@ func hasCreatorSession(page *rod.Page) bool {
 		return false
 	}
 	for _, c := range cks {
-		if c.Name == creatorSessionCookie {
+		if c.Name == creatorSessionCookie || c.Name == creatorUserIDCookie {
+			return true
+		}
+	}
+	return false
+}
+
+// onCreatorPageWithWebSession 新版创作者中心复用 .xiaohongshu.com 的 web_session（issue #919）：
+// 页面停在 creator 域且没有被重定向到登录页，同时 web_session 存在，即视为已登录。
+func onCreatorPageWithWebSession(page *rod.Page) bool {
+	info, err := page.Info()
+	if err != nil {
+		return false
+	}
+	u, err := url.Parse(info.URL)
+	if err != nil || u.Host != creatorHost || strings.Contains(u.Path, "login") {
+		return false
+	}
+	cks, err := page.Browser().GetCookies()
+	if err != nil {
+		return false
+	}
+	for _, c := range cks {
+		if c.Name == webSessionCookie && c.Value != "" {
 			return true
 		}
 	}
diff --git a/xiaohongshu/publish.go b/xiaohongshu/publish.go
index 089656e..8e4682d 100644
--- a/xiaohongshu/publish.go
